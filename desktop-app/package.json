{
	"name": "openamx-desktop",
	"version": "0.11.0",
	"private": true,
	"type": "module",
	"description": "OpenAMX desktop authoring workbench",
	"scripts": {
		"dev": "bun run build:web && hutch electrobun dev --watch",
		"typecheck": "hutch electrobun prepare && vue-tsc --noEmit",
		"build:web": "hutch electrobun prepare && vite build && bun build src/bun/jobWorker.ts --target=bun --outfile=dist/jobWorker.js && bun run scripts/copy-sharp-runtime.ts && bun run scripts/copy-pdfmake-fonts.ts",
		"build": "bun run build:web && hutch electrobun build --env=stable",
		"test": "bun run tests/rpc-contract-check.ts",
		"test:ui": "playwright test",
		"test:theme": "bun run build:web && playwright test --config playwright.theme.config.ts",
		"run": "bun run build:web && hutch electrobun build --env=dev && hutch electrobun run --env=dev"
	},
	"dependencies": {
		"@codemirror/autocomplete": "6.20.3",
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/search": "6.7.2",
		"@fontsource/dm-mono": "5.3.0",
		"@fontsource/dm-sans": "5.3.0",
		"@fontsource/newsreader": "5.3.0",
		"@lucide/vue": "1.48.0",
		"buffer": "6.0.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"codemirror": "6.0.2",
		"docx": "9.8.1",
		"json-editor-vue": "0.19.2",
		"reka-ui": "2.10.5",
		"tailwind-merge": "3.7.0",
		"vanilla-jsoneditor": "3.13.0",
		"vue": "3.5.41",
		"vxe-pc-ui": "4.18.21",
		"vxe-table": "4.22.3",
		"xe-utils": "4.1.2"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "1.4.0",
		"@vitejs/plugin-vue": "5.2.4",
		"pdfjs-dist": "6.3.289",
		"pdfmake": "0.3.11",
		"shadcn-vue": "2.8.2",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.3",
		"vite": "6.4.3",
		"vue-tsc": "2.2.12"
	}
}
