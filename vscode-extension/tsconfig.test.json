{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "out",
    "rootDir": "..",
    "types": [
      "bun",
      "mocha",
      "node",
      "vscode"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}