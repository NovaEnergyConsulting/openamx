{
    "scopeName": "source.amx",
    "patterns": [
        {
            "include": "#frontmatter"
        },
        {
            "include": "#executable-fence"
        },
        {
            "include": "#inert-fence"
        },
        {
            "include": "#markdown-heading"
        },
        {
            "include": "#markdown-inline-code"
        },
        {
            "include": "#markdown-emphasis"
        },
        {
            "include": "#markdown-link"
        },
        {
            "include": "#interpolation"
        }
    ],
    "repository": {
        "frontmatter": {
            "begin": "\\A---[ \\t]*$",
            "end": "^---[ \\t]*$",
            "name": "meta.frontmatter.amx",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.frontmatter.begin.amx"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.frontmatter.end.amx"
                }
            },
            "patterns": [
                {
                    "match": "^[ \\t]*#[^\\r\\n]*$",
                    "name": "comment.line.number-sign.yaml"
                },
                {
                    "match": "^[ \\t]*([A-Za-z_][A-Za-z0-9_-]*)([ \\t]*:)",
                    "captures": {
                        "1": {
                            "name": "entity.name.tag.yaml"
                        },
                        "2": {
                            "name": "punctuation.separator.key-value.yaml"
                        }
                    }
                },
                {
                    "match": "(?<![A-Za-z0-9_])[A-Za-z_][A-Za-z0-9_-]*(?=[ \\t]*:)",
                    "name": "entity.name.tag.yaml"
                },
                {
                    "match": "\\b(true|false|null|yes|no|on|off)\\b",
                    "name": "constant.language.yaml"
                },
                {
                    "match": "(?<![A-Za-z0-9_.])-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?\\b",
                    "name": "constant.numeric.yaml"
                },
                {
                    "match": "\\b#[0-9A-Fa-f]{6}\\b",
                    "name": "constant.other.color.yaml"
                },
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.yaml",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.yaml"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.yaml"
                        }
                    }
                },
                {
                    "begin": "'",
                    "end": "'",
                    "name": "string.quoted.single.yaml",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.yaml"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.yaml"
                        }
                    }
                }
            ]
        },
        "executable-fence": {
            "begin": "^ {0,3}(`{3,})[ \\t]*(amx)[ \\t]*$",
            "end": "^ {0,3}\\1`*[ \\t]*$",
            "name": "meta.embedded.block.amx",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.fence.begin.markdown"
                },
                "2": {
                    "name": "constant.language.amx"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.fence.end.markdown"
                },
                "1": {
                    "name": "punctuation.definition.fence.end.markdown"
                }
            },
            "contentName": "meta.block.amx",
            "patterns": [
                {
                    "include": "#amx"
                }
            ]
        },
        "inert-fence": {
            "begin": "^ {0,3}(`{3,}|~{3,})[^\\r\\n]*$",
            "end": "^ {0,3}\\1[ \\t]*$",
            "name": "markup.fenced_code.block.markdown",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.fence.begin.markdown"
                }
            },
            "endCaptures": {
                "1": {
                    "name": "punctuation.definition.fence.end.markdown"
                }
            }
        },
        "markdown-heading": {
            "match": "^ {0,3}(#{1,6})([ \\t]+)(.*)$",
            "captures": {
                "1": {
                    "name": "punctuation.definition.heading.markdown"
                },
                "3": {
                    "name": "markup.heading.markdown"
                }
            }
        },
        "markdown-inline-code": {
            "begin": "(`+)",
            "end": "\\1",
            "name": "markup.inline.raw.string.markdown",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.raw.markdown"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.raw.markdown"
                }
            }
        },
        "markdown-emphasis": {
            "patterns": [
                {
                    "match": "(\\*\\*|__)(?=\\S)(.*?\\S)\\1",
                    "name": "markup.bold.markdown"
                },
                {
                    "match": "(\\*|_)(?=\\S)(.*?\\S)\\1",
                    "name": "markup.italic.markdown"
                }
            ]
        },
        "markdown-link": {
            "match": "(!?)(\\[)([^]]+)(\\])(\\()([^ )]+)(\\))",
            "captures": {
                "1": {
                    "name": "punctuation.definition.image.markdown"
                },
                "2": {
                    "name": "punctuation.definition.link.begin.markdown"
                },
                "3": {
                    "name": "string.other.link.title.markdown"
                },
                "4": {
                    "name": "punctuation.definition.link.end.markdown"
                },
                "5": {
                    "name": "punctuation.definition.link.begin.markdown"
                },
                "6": {
                    "name": "markup.underline.link.markdown"
                },
                "7": {
                    "name": "punctuation.definition.link.end.markdown"
                }
            }
        },
        "interpolation": {
            "begin": "\\{\\{",
            "end": "\\}\\}",
            "name": "meta.interpolation.amx",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.section.interpolation.begin.amx"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.interpolation.end.amx"
                }
            },
            "patterns": [
                {
                    "include": "#amx"
                }
            ]
        },
        "amx": {
            "patterns": [
                {
                    "include": "#amx-strings"
                },
                {
                    "include": "#amx-function-declaration"
                },
                {
                    "include": "#amx-type-declaration"
                },
                {
                    "include": "#amx-enum-declaration"
                },
                {
                    "include": "#amx-view-declaration"
                },
                {
                    "include": "#amx-keywords"
                },
                {
                    "include": "#amx-types"
                },
                {
                    "include": "#amx-constants"
                },
                {
                    "include": "#amx-builtin-functions"
                },
                {
                    "include": "#amx-function-calls"
                },
                {
                    "include": "#amx-numbers"
                },
                {
                    "include": "#amx-operators"
                },
                {
                    "include": "#amx-punctuation"
                }
            ]
        },
        "amx-strings": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"|$",
                    "name": "string.quoted.double.amx",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.amx"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.amx"
                        }
                    },
                    "patterns": [
                        {
                            "begin": "(?<!\\\\)(?:\\\\\\\\)*(\\$\\{)",
                            "end": "\\}|$",
                            "name": "meta.interpolation.string.amx",
                            "beginCaptures": {
                                "1": {
                                    "name": "punctuation.section.interpolation.begin.amx"
                                }
                            },
                            "endCaptures": {
                                "0": {
                                    "name": "punctuation.section.interpolation.end.amx"
                                }
                            },
                            "patterns": [
                                {
                                    "include": "#amx-expression-braces"
                                },
                                {
                                    "include": "#amx"
                                }
                            ]
                        },
                        {
                            "match": "\\\\(?:[\"'\\\\nrt]|\\$\\{)",
                            "name": "constant.character.escape.amx"
                        }
                    ]
                },
                {
                    "begin": "'",
                    "end": "'|$",
                    "name": "string.quoted.single.amx",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.amx"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.amx"
                        }
                    },
                    "patterns": [
                        {
                            "match": "\\\\(?:[\"'\\\\nrt]|\\$\\{)",
                            "name": "constant.character.escape.amx"
                        }
                    ]
                }
            ]
        },
        "amx-expression-braces": {
            "begin": "\\{",
            "end": "\\}|$",
            "name": "meta.brace.expression.amx",
            "patterns": [
                {
                    "include": "#amx-expression-braces"
                },
                {
                    "include": "#amx"
                }
            ]
        },
        "amx-function-declaration": {
            "match": "\\b(fn)(\\s+)([A-Za-z][A-Za-z0-9_]*)",
            "captures": {
                "1": {
                    "name": "keyword.declaration.function.amx"
                },
                "3": {
                    "name": "entity.name.function.amx"
                }
            }
        },
        "amx-type-declaration": {
            "match": "\\b(type)(\\s+)([A-Za-z][A-Za-z0-9_]*)",
            "captures": {
                "1": {
                    "name": "keyword.declaration.type.amx"
                },
                "3": {
                    "name": "entity.name.type.amx"
                }
            }
        },
        "amx-enum-declaration": {
            "begin": "\\b(enum)(\\s+)([A-Za-z][A-Za-z0-9_]*)(?=\\s*=\\s*\\{)",
            "end": "\\}",
            "name": "meta.declaration.enum.amx",
            "beginCaptures": {
                "1": {
                    "name": "keyword.declaration.enum.amx"
                },
                "3": {
                    "name": "entity.name.type.enum.amx"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.block.end.amx"
                }
            },
            "patterns": [
                {
                    "include": "#amx-strings"
                },
                {
                    "match": "\\b([A-Za-z][A-Za-z0-9_]*)\\b(?=\\s*(?:=|,|}|$))",
                    "captures": {
                        "1": {
                            "name": "entity.name.enum-member.amx"
                        }
                    }
                },
                {
                    "include": "#amx-numbers"
                },
                {
                    "include": "#amx-operators"
                },
                {
                    "include": "#amx-punctuation"
                }
            ]
        },
        "amx-view-declaration": {
            "match": "\\b(table|chart)(\\s+)([A-Za-z][A-Za-z0-9_]*)(\\s*=)",
            "captures": {
                "1": {
                    "name": "keyword.declaration.view.amx"
                },
                "3": {
                    "name": "entity.name.view.amx"
                },
                "4": {
                    "name": "keyword.operator.assignment.amx"
                }
            }
        },
        "amx-keywords": {
            "patterns": [
                {
                    "match": "\\b(export|import|from|input|let|type|enum|extends|override|fn|return|for|in|if|then|else|match|case|default|show|table|chart|dimension|unit|add|remove|at)\\b",
                    "name": "keyword.control.amx"
                },
                {
                    "match": "\\b(bar|column|line|scatter)(?=\\s*\\()",
                    "name": "support.function.visualization.amx"
                },
                {
                    "match": "\\b(title|description|column|as|category|x|y|group|labels|series)\\b",
                    "name": "keyword.other.option.amx"
                },
                {
                    "match": "\\bto\\b",
                    "name": "keyword.operator.range.amx"
                },
                {
                    "match": "\\b(and|or|not)\\b",
                    "name": "keyword.operator.logical.amx"
                }
            ]
        },
        "amx-types": {
            "match": "\\b(Number|String|Boolean|DateTime)\\b",
            "name": "storage.type.amx"
        },
        "amx-constants": {
            "match": "\\b(true|false|null)\\b",
            "name": "constant.language.amx"
        },
        "amx-builtin-functions": {
            "match": "\\b(sum|min|max|mean|round|abs|sqrt|pow)(?=\\s*\\()",
            "name": "support.function.builtin.amx"
        },
        "amx-function-calls": {
            "match": "\\b[A-Za-z][A-Za-z0-9_]*(?=\\s*\\()",
            "name": "entity.name.function.call.amx"
        },
        "amx-numbers": {
            "match": "(?<![A-Za-z0-9_])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?",
            "name": "constant.numeric.amx"
        },
        "amx-operators": {
            "match": "\\+=|==|!=|>=|<=|=>|=(?!=)|[+*/%^<>-]",
            "name": "keyword.operator.amx"
        },
        "amx-punctuation": {
            "patterns": [
                {
                    "match": "[{}]",
                    "name": "punctuation.section.block.amx"
                },
                {
                    "match": "[()\\[\\]]",
                    "name": "punctuation.section.group.amx"
                },
                {
                    "match": "[.,:]",
                    "name": "punctuation.separator.amx"
                },
                {
                    "match": "[?]",
                    "name": "keyword.operator.type-suffix.amx"
                }
            ]
        }
    }
}