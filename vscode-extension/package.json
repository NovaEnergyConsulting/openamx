{
  "name": "openamx-vscode",
  "displayName": "OpenAMX",
  "description": "Formatting, completion, static diagnostics, navigation, outline, references and contextual fixes for OpenAMX documents.",
  "version": "0.8.0",
  "publisher": "EngineersTools",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/NovaEnergyConsulting/openamx.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "amx",
        "aliases": [
          "OpenAMX",
          "amx"
        ],
        "extensions": [
          ".amx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "amx",
        "scopeName": "source.amx",
        "path": "./amx.tmGrammar.json"
      }
    ]
  },
  "scripts": {
    "compile": "node ./esbuild.mjs",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "test": "bun run compile && bun run compile-tests && node ./out/vscode-extension/src/test/runTest.js",
    "package": "node ./package-local.mjs",
    "install-local": "node ./install-local.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.5",
    "mocha": "^10.8.2",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}